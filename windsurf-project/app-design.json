{
  "app": {
    "name": "Aai Ji Mini Market",
    "package": "com.aaiji.minimarket",
    "version": "1.0.0",
    "category": "Shopping",
    "theme": {
      "primary": "#28a745",
      "secondary": "#17a2b8",
      "accent": "#ffc107"
    }
  },
  "screens": [
    {
      "id": "home",
      "name": "Home",
      "components": [
        {
          "type": "header",
          "text": "Aai Ji Mini Market",
          "subtitle": "Free delivery within 5km • Min order ₹500",
          "backgroundColor": "#28a745",
          "textColor": "#ffffff"
        },
        {
          "type": "search",
          "placeholder": "Search products...",
          "icon": "search"
        },
        {
          "type": "categories",
          "layout": "grid",
          "items": [
            {"id": "grains", "name": "Grains & Staples", "icon": "🌾", "color": "#8B4513"},
            {"id": "dals", "name": "Dals & Pulses", "icon": "🫘", "color": "#D2691E"},
            {"id": "oil", "name": "Oil & Ghee", "icon": "🛢️", "color": "#FFD700"},
            {"id": "spices", "name": "Spices & Masala", "icon": "🧂", "color": "#FF6347"},
            {"id": "snacks", "name": "Snacks & Foods", "icon": "🍪", "color": "#DEB887"},
            {"id": "beverages", "name": "Beverages", "icon": "🥤", "color": "#4682B4"},
            {"id": "dairy", "name": "Dairy Products", "icon": "🥛", "color": "#87CEEB"},
            {"id": "personal", "name": "Personal Care", "icon": "🧼", "color": "#98FB98"},
            {"id": "household", "name": "Household", "icon": "🧹", "color": "#F0E68C"}
          ]
        },
        {
          "type": "featured",
          "title": "Featured Products",
          "items": [
            {"name": "Basmati Rice", "price": 120, "unit": "1kg", "image": "rice"},
            {"name": "Toor Dal", "price": 100, "unit": "1kg", "image": "toor"},
            {"name": "Sunflower Oil", "price": 150, "unit": "1L", "image": "sunflower"},
            {"name": "Tea Powder", "price": 120, "unit": "250g", "image": "tea"}
          ]
        }
      ]
    },
    {
      "id": "products",
      "name": "Products",
      "components": [
        {
          "type": "filter",
          "options": ["All", "Grains", "Dals", "Oil", "Spices", "Snacks", "Beverages", "Dairy", "Personal", "Household"]
        },
        {
          "type": "productGrid",
          "layout": "grid",
          "columns": 2
        }
      ]
    },
    {
      "id": "cart",
      "name": "Shopping Cart",
      "components": [
        {
          "type": "cartItems",
          "layout": "list"
        },
        {
          "type": "summary",
          "showSubtotal": true,
          "showDelivery": true,
          "showTotal": true
        },
        {
          "type": "checkout",
          "button": "Place Order"
        }
      ]
    },
    {
      "id": "checkout",
      "name": "Checkout",
      "components": [
        {
          "type": "form",
          "fields": [
            {"name": "customerName", "label": "Full Name", "required": true},
            {"name": "phone", "label": "Phone Number", "required": true},
            {"name": "address", "label": "Delivery Address", "required": true},
            {"name": "area", "label": "Delivery Area", "type": "select", "required": true},
            {"name": "notes", "label": "Order Notes", "type": "textarea"}
          ]
        },
        {
          "type": "payment",
          "options": ["Cash on Delivery", "UPI Payment"]
        },
        {
          "type": "confirm",
          "button": "Confirm Order"
        }
      ]
    }
  ],
  "navigation": {
    "bottom": [
      {"id": "home", "icon": "home", "label": "Home"},
      {"id": "products", "icon": "shopping_basket", "label": "Products"},
      {"id": "cart", "icon": "shopping_cart", "label": "Cart"},
      {"id": "orders", "icon": "list", "label": "Orders"},
      {"id": "contact", "icon": "phone", "label": "Contact"}
    ]
  }
}
